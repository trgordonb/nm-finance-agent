{
  "version": 1,
  "servers": {
    "agent_browser": {
      "transport": "stdio",
      "command": "agent-browser",
      "args": [
        "mcp",
        "--tools",
        "core"
      ],
      "env": {
        "AGENT_BROWSER_SESSION": "nm-agent"
      },
      "enabled": true,
      "description": "Local Chrome automation (Rust CLI, core tool profile); dedicated nm-agent browser session"
    },
    "luxalgo": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@luxalgo/mcp"
      ],
      "keep_tools": [
        "library_search",
        "library_get_concept",
        "library_get_indicator",
        "library_get_source_code",
        "library_list_concepts",
        "library_list_indicators",
        "library_list_tags",
        "library_list_families",
        "library_get_family",
        "trackers_datasets",
        "trackers_query",
        "trackers_latest",
        "trackers_ticker"
      ],
      "enabled": true,
      "description": "LuxAlgo: indicator/library docs + market trackers (public, keyless; journal/brokers/account filtered out)"
    },
    "agentdb": {
      "transport": "stdio",
      "command": "node_modules/.bin/agentdb",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "AGENTDB_PATH": "${AGENTDB_MCP_DIR}/_discovery/agentdb-mcp.db"
      },
      "keep_tools": [
        "agentdb_stats",
        "agentdb_pattern_store",
        "agentdb_pattern_search",
        "reflexion_store",
        "reflexion_retrieve",
        "skill_create",
        "skill_search",
        "reward_signal",
        "learning_feedback",
        "learning_start_session",
        "learning_end_session",
        "learning_metrics",
        "consolidate_now"
      ],
      "enabled": true,
      "description": "AgentDB MCP pilot (npm v2 stdio): Reflexion episodes + skill library + ReasoningBank + learning loop; TypeScript-side binding of the cognitive-memory tools (Gate 1)"
    },
    "finance_toolkit": {
      "transport": "streamable_http",
      "url": "https://financetoolkit.jeroenbouma.com/mcp",
      "headers": {
        "Authorization": "Bearer ${FINANCIAL_MODELING_PREP_API_KEY}"
      },
      "keep_tools": [
        "breadth",
        "discovery",
        "market_data",
        "models",
        "momentum",
        "overlap",
        "rates",
        "risk",
        "volatility",
        "search_categories",
        "search_by_category",
        "search_metrics",
        "search_instruments"
      ],
      "enabled": false,
      "description": "FinanceToolkit analytics (FMP-backed; dormant since 2026-09; streamable_http binding implemented)"
    },
    "vibe_trading": {
      "transport": "stdio",
      "command": "vibe-trading-mcp",
      "args": [],
      "keep_tools": [
        "list_skills",
        "load_skill",
        "get_institutional_holdings",
        "etf_holdings",
        "get_market_data",
        "search_symbol",
        "get_fundamentals",
        "get_stock_profile",
        "get_stock_news",
        "get_sec_filings",
        "get_research_reports",
        "search_broker_reports",
        "get_financial_statements",
        "get_options_chain",
        "technical_indicators",
        "screen_market",
        "get_macro_series",
        "sentiment",
        "backtest",
        "factor_analysis",
        "alpha_zoo",
        "alpha_bench"
      ],
      "enabled": true,
      "description": "Vibe-Trading (HKUDS, PyPI vibe-trading-ai, uv tool, py3.12): read-only research — 13F/ETF holdings, market data, news/filings, options, macro, backtest/factors — plus its skill docs (list_skills/load_skill, e.g. backtest-diagnose) so agents can read the SignalEngine contract before coding; trading_*/paper_trade/swarm/file-IO/web tools filtered out via keep_tools; shell tools left off (RCE surface)"
    }
  }
}
