# LLM: OpenAI-compatible endpoint (same defaults family as langgraph-demo)
OPENAI_API_KEY=
OPENAI_MODEL_ID=glm-5.3-flash
OPENAI_BASE_URL=https://api.b.ai/v1/
MAX_COMPLETION_TOKENS=16384

# Retrieval
TAVILY_API_KEY=
# Optional: Jina Reader for web_to_markdown (rate-limited without a key)
JINA_API_KEY=

# Tracing (LangSmith REST runs API). Enabled when LANGSMITH_API_KEY (or the
# legacy LANGCHAIN_API_KEY) is present; LANGSMITH_TRACING=0 disables explicitly.
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=nm-finance-agent

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Storage: the archive + memory belong to the consuming agent's cwd
# SESSION_DB_PATH=./sessions.db
# MEMORY_DIR=./memories
# Agent scratch area: relative fs-tool paths + execute cwd resolve here
# WORKSPACE_DIR=./workspace
# WORKSPACE_HARD_JAIL=1   # refuse fs writes outside the workspace (for network-exposed servers)
