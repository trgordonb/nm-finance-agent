# LLM: OpenRouter for all models (main loop + future secondary calls)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_MAIN=z-ai/glm-5.3-flash
OPENROUTER_MODEL_SUMMARIZER=liquid/lfm-2.5-2.6b:free
# Preferred provider order for the main model (OpenRouter provider steering)
OPENROUTER_MAIN_MODEL_PROVIDER=relace,open-inference/fp4,novita/fp8
# OPENROUTER_PROVIDER_FALLBACKS=1   # 0 disables cross-provider fallback
# OPENROUTER_REASONING=1            # 0 omits the reasoning block
# MAX_COMPLETION_TOKENS=16384

# Retrieval
TAVILY_API_KEY=
# Optional: Jina Reader for web_to_markdown (out of balance → Tavily Extract fallback)
JINA_API_KEY=

# Tracing (LangSmith REST runs API). Enabled when LANGSMITH_API_KEY (or the
# legacy LANGCHAIN_API_KEY) is present; LANGSMITH_TRACING=0 disables explicitly.
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=nm-finance-agent

# AgentDB mirror (semantic recall sidecar; archive stays authoritative)
# AGENTDB_MIRROR=0
# AGENTDB_PATH=./agent-mirror.db

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Storage: the archive + memory belong to the consuming agent's cwd
# SESSION_DB_PATH=./sessions.db
# MEMORY_DIR=./memories
# Agent scratch area: relative fs-tool paths + execute cwd resolve here
# WORKSPACE_DIR=./workspace
# WORKSPACE_HARD_JAIL=1   # refuse fs writes outside the workspace (for network-exposed servers)
