# LLM: OpenRouter for all models (main loop + future secondary calls)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_MAIN=z-ai/glm-5.3-flash
OPENROUTER_MODEL_SUMMARIZER=poolside/laguna-xs-2.1:free
# Preferred provider order for the main model (OpenRouter provider steering)
# Relace was removed/ignored after returning degenerate text at HTTP 200
# (2026-10-19: garbage brief + no-tool-call supervisor => "research nothing").
OPENROUTER_MAIN_MODEL_PROVIDER=open-inference/fp4,deepinfra/fp4,novita/fp8
OPENROUTER_PROVIDER_IGNORE=relace  # comma-separated provider slugs to exclude
# OPENROUTER_PROVIDER_FALLBACKS=1   # 0 disables cross-provider fallback
# OPENROUTER_REASONING=1            # 0 omits the reasoning block
# Legacy fallbacks (only if the OPENROUTER_* names above are unset)
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=
# OPENROUTER_MODEL=
#
# LLM client tuning
# LLM_MIN_INTERVAL_MS=4000        # minimum spacing between LLM calls (rate-limit)
# LLM_MAX_ATTEMPTS=5              # transient-error retry cap (5xx/429/dial)
# LLM_TIMEOUT_MS=300000           # per-request HTTP timeout

# Agentic loop
# EXECUTE_TIMEOUT_MS=120000       # execute tool hard timeout (timed-out commands
                                  # are recoverable: the agent is told to background
                                  # long-running pipelines instead)
# BUDGET_TOOL_MAX_ITERATIONS=25   # assistant/tool round-trips per turn

# Retrieval
TAVILY_API_KEY=
# Optional: Jina Reader for web_to_markdown (out of balance → Tavily Extract fallback)
JINA_API_KEY=
# Deep research (/research prefix): Exa server-side page summaries (~$0.001/page).
# Without the key (or EXA_SUMMARIZER=off) summaries fall back to the summarizer model.
EXA_API_KEY=

# Deep research (/research). All research LLM roles use OPENROUTER_MODEL_MAIN
# (single model for now); the page-summary fallback uses OPENROUTER_MODEL_SUMMARIZER.
# RESEARCH_MODE_ENABLED=1
# RESEARCH_MAX_CONCURRENT=3              # parallel researchers per fan-out chunk
# RESEARCH_MAX_SUPERVISOR_ITERATIONS=10  # supervisor tool calls before forced stop
# RESEARCH_MAX_RESEARCH_ROUNDS=2         # ConductResearch batches (not tool calls)
# RESEARCH_MAX_RESEARCHER_TURNS=5        # per-researcher tool turns before compression
# RESEARCH_MAX_RESEARCHER_SEARCHES=6     # enforced per-researcher Tavily search cap
# RESEARCH_TOKEN_BUDGET=300000           # per-researcher input+output tokens
# RESEARCH_REASONING_EFFORT=low          # low | medium | high (GLM always thinks)
# RESEARCH_LLM_TIMEOUT_MS=600000         # per-request research LLM timeout
# RESEARCH_LLM_MAX_ATTEMPTS=2            # research retry cap (1 = no retry)
# RESEARCH_SEARCH_MAX_RESULTS=3          # Tavily results per search call
# RESEARCH_PAGE_CONTEXT_CHARS=60000      # raw page chars fed to summarization
# RESEARCH_LLM_MIN_INTERVAL_MS=1200      # min spacing between research LLM calls
# RESEARCH_DEADLINE_MINUTES=15           # whole-run wall-clock cap (0 = off)
# RESEARCH_SAVE_REPORTS=1                # save reports to workspace/research/
# RESEARCH_AS_TOOL=1                     # also expose deep_research as a main-agent
                                         # tool (default off: real spend per run)

# Search summarizer (Hermes-style): one cheap-model condensing pass over the
# hybrid session_search results; python-parity header + silent fallback.
SEARCH_SUMMARIZER_ENABLED=true
# Enrichment only: bound the free summarizer and fall back to raw excerpts.
# SEARCH_SUMMARIZER_TIMEOUT_MS=20000
# SEARCH_SUMMARIZER_MAX_ATTEMPTS=2
# Follow-ups ("next steps" to-do strip; extraction via the summarizer model)
# FOLLOWUPS_ENABLED=0           # disable the end-of-turn extractor

# Tracing (LangSmith REST runs API). Enabled when LANGSMITH_API_KEY (or the
# legacy LANGCHAIN_API_KEY) is present; LANGSMITH_TRACING=0 disables explicitly.
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=nm-finance-agent
# LANGSMITH_BASE_URL=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=           # legacy alias for LANGSMITH_API_KEY
# LANGSMITH_TRACING=0          # explicitly disable even with a key
# LANGSMITH_TIMEOUT_MS=5000    # per fire-and-forget call timeout

# AgentDB mirror (semantic recall sidecar; archive stays authoritative)
# AGENTDB_MIRROR=0             # disable the sidecar entirely
# AGENTDB_PATH=./agent-mirror.db
# AGENTDB_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# AGENTDB_MAX_ELEMENTS=100000  # HNSW preallocation hint (auto-grows; ≈1.4GB VA at 100k)
# AGENTDB_REQUEST_TIMEOUT_MS=180000
# AGENTDB_SIDECAR_READY_MS=120000   # model load budget before "not ready"
# AGENTDB_REMOTE_URL=               # container mirror over HTTPS (container/README.md)
#                                   # -> set: skips the local sidecar entirely
# AGENTDB_REMOTE_TOKEN=             # bearer token (Worker secret MIRROR_TOKEN)
# AGENTDB_REMOTE_STATUS_MS=10000    # /status probe at boot (container stays asleep)

# MCP servers (stdio / streamable_http / sse; see mcp_servers.json)
# MCP_SERVERS_FILE=mcp_servers.json
# MCP_CONNECT_TIMEOUT_MS=30000
# MCP_CALL_TIMEOUT_MS=120000

# Skills: local working copy + per-user enable/disable state; the R2
# authority is driven through the nm-skills CLI at boot (pull+push) and via a
# debounced curation push. Reads never touch R2. Without SKILLS_REQUIRED the
# bridge degrades to local-only on any failure (health-visible).
# Deploy notes: docs/skills-registry-deploy.md
SKILLS_REGISTRY=s3://neuralmatrix
# SKILLS_DIR=/data/skills             # mirrored working copy (VM: persistent volume)
# SKILLS_STATE_DIR=/data/state        # toggles: state/users/<user>/skills.json
# SKILLS_USER_ID=default              # per-user toggle profile (sanitised slug)
# SKILLS_CLI_BRIDGE=0                 # local-only (skip the R2 lifecycle)
# NM_SKILLS_REGISTRY_HOME=../nm-skills-registry   # uv project checkout (absolute on a VM)
# SKILLS_CLI=                         # installed nm-skills binary; skips `uv run --directory`
# SKILLS_REQUIRED=0                   # 1 = refuse to boot if pull fails or yields 0 skills
# UV_BIN=uv                           # uv binary (when SKILLS_CLI is unset)
# SKILLS_CLI_TIMEOUT_MS=90000
# SKILLS_PUSH_DEBOUNCE_MS=5000        # curation → push debounce window

# llmwiki service (Wiki tab + the llm-wiki skill)
# Local Docker: leave these blank — the proxy defaults to http://127.0.0.1:8010
# and the service's read routes are open. Remote (Cloudflare Containers): the
# Worker gates reads too, so set both the URL and the service's token.
# WIKI_API_URL=https://llmwiki.<subdomain>.workers.dev
# WIKI_API_TOKEN=                    # = llm-wiki-svc INGEST_API_TOKEN
# WIKI_PROXY_TIMEOUT_MS=60000        # read-proxy cold-start budget
# The skill runs as a subprocess and resolves its own URL; point it remotely:
# LLMWIKI_URL=https://llmwiki.<subdomain>.workers.dev

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=3001

# Storage: the archive + memory belong to the consuming agent's cwd
# SESSION_DB_PATH=./sessions.db
# MEMORY_DIR=./memories
# Agent scratch area: relative fs-tool paths + execute cwd resolve here
# WORKSPACE_DIR=./workspace
# WORKSPACE_HARD_JAIL=1   # refuse fs writes outside the workspace (for network-exposed servers)
